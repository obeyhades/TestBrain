// Database schema for TestBrain.
//
// Models are added phase by phase. Today this covers authentication and projects;
// requirements, test cases, test runs, defects and releases follow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What somebody may do inside one project. A person can hold a different role in
/// every project they belong to, which is why this lives on ProjectMember rather
/// than on User.
enum ProjectRole {
  ADMIN
  PROJECT_MANAGER
  QA
  DEVELOPER
}

/// How far along a requirement is. Deliberately three states: anything finer is a
/// project-management tool, which this is not.
enum RequirementStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// Argon2id hash. The plaintext password is never stored or logged.
  passwordHash String

  /// Whoever registers first owns the instance. Instance admins create accounts;
  /// what someone may do *inside* a project is decided by their project role.
  isInstanceAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  memberships         ProjectMember[]
  createdProjects     Project[]       @relation("ProjectCreatedBy")
  createdRequirements Requirement[]   @relation("RequirementCreatedBy")
}

/// A signed-in session.
///
/// The id is the SHA-256 hash of the token held in the user's cookie, so a leaked
/// database dump contains no usable session tokens. Sessions live in the database
/// rather than in a JWT so that logging out actually revokes access.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PostgreSQL does not index foreign keys automatically, and every logout-everywhere
  // and cascade delete looks sessions up by user.
  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, not Cascade: removing a person must never silently delete the
  // projects they happened to create.
  createdBy    User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  requirements Requirement[]

  @@index([createdById])
}

/// Somebody's place in one project. Membership is itself the permission to see the
/// project at all; the role decides what they may change.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One role per person per project, decided by the database rather than by code
  // remembering to check.
  @@unique([projectId, userId])
  // Listing "my projects" looks members up by user alone.
  @@index([userId])
}

/// Something the product is supposed to do. Test cases link to these later, which is
/// what makes the trail from requirement to release readable.
model Requirement {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequirementStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("RequirementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Every listing is "the requirements of one project".
  @@index([projectId])
  @@index([createdById])
}
