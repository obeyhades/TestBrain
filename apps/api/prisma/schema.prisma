// Database schema for TestBrain.
//
// Models are added phase by phase. Today this covers authentication and projects;
// requirements, test cases, test runs, defects and releases follow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What somebody may do inside one project. A person can hold a different role in
/// every project they belong to, which is why this lives on ProjectMember rather
/// than on User.
enum ProjectRole {
  ADMIN
  PROJECT_MANAGER
  QA
  DEVELOPER
}

/// How far along a requirement is. Deliberately three states: anything finer is a
/// project-management tool, which this is not.
enum RequirementStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestRunStatus {
  OPEN
  COMPLETED
}

/// The outcome of running one test case in one test run.
enum TestResultStatus {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A fixed, readable path from reported to done. Not a configurable workflow: a
/// team that needs one has outgrown this tool.
enum DefectStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_TEST
  VERIFIED
  CLOSED
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// Argon2id hash. The plaintext password is never stored or logged.
  passwordHash String

  /// Whoever registers first owns the instance. Instance admins create accounts;
  /// what someone may do *inside* a project is decided by their project role.
  isInstanceAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  memberships         ProjectMember[]
  createdProjects     Project[]       @relation("ProjectCreatedBy")
  createdRequirements Requirement[]   @relation("RequirementCreatedBy")
  createdTestCases    TestCase[]      @relation("TestCaseCreatedBy")
  createdTestRuns     TestRun[]       @relation("TestRunCreatedBy")
  executedResults     TestResult[]    @relation("TestResultExecutedBy")
  reportedDefects     Defect[]        @relation("DefectCreatedBy")
  assignedDefects     Defect[]        @relation("DefectAssignedTo")
}

/// A signed-in session.
///
/// The id is the SHA-256 hash of the token held in the user's cookie, so a leaked
/// database dump contains no usable session tokens. Sessions live in the database
/// rather than in a JWT so that logging out actually revokes access.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PostgreSQL does not index foreign keys automatically, and every logout-everywhere
  // and cascade delete looks sessions up by user.
  @@index([userId])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict, not Cascade: removing a person must never silently delete the
  // projects they happened to create.
  createdBy    User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  requirements Requirement[]
  testCases    TestCase[]
  testRuns     TestRun[]
  defects      Defect[]

  @@index([createdById])
}

/// Somebody's place in one project. Membership is itself the permission to see the
/// project at all; the role decides what they may change.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One role per person per project, decided by the database rather than by code
  // remembering to check.
  @@unique([projectId, userId])
  // Listing "my projects" looks members up by user alone.
  @@index([userId])
}

/// Something the product is supposed to do. Test cases link to these later, which is
/// what makes the trail from requirement to release readable.
model Requirement {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequirementStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User       @relation("RequirementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  testCases TestCase[]

  // Every listing is "the requirements of one project".
  @@index([projectId])
  @@index([createdById])
}

/// How something is verified. Steps live in their own table so each one keeps its
/// own action and expected result rather than being buried in a blob of text.
model TestCase {
  id            String   @id @default(cuid())
  projectId     String
  requirementId String?
  title         String
  description   String?
  preconditions String?
  priority      Priority @default(MEDIUM)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: deleting a requirement must not delete the tests that
  // happened to be linked to it.
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TestCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  steps       TestStep[]
  results     TestResult[]
  defects     Defect[]

  @@index([projectId])
  @@index([requirementId])
  @@index([createdById])
}

model TestStep {
  id             String @id @default(cuid())
  testCaseId     String
  position       Int
  action         String
  expectedResult String

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  // Two steps cannot share a position in the same test case.
  @@unique([testCaseId, position])
}

/// One round of testing, for example "Regression - v1.4.0".
model TestRun {
  id        String        @id @default(cuid())
  projectId String
  name      String
  status    TestRunStatus @default(OPEN)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User         @relation("TestRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  results   TestResult[]
  defects   Defect[]

  @@index([projectId])
  @@index([createdById])
}

/// One test case inside one test run.
///
/// This is also what puts a test case into a run: adding a case means creating a
/// result for it, still NOT_RUN. One table instead of two, so "what is in the run"
/// and "how it went" can never disagree.
model TestResult {
  id         String           @id @default(cuid())
  testRunId  String
  testCaseId String
  status     TestResultStatus @default(NOT_RUN)
  notes      String?

  executedById String?
  executedAt   DateTime?

  testRun    TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executedBy User?    @relation("TestResultExecutedBy", fields: [executedById], references: [id], onDelete: SetNull)

  // A test case appears at most once in a run.
  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@index([testCaseId])
  @@index([executedById])
}

/// Something that is wrong with the product.
model Defect {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?
  severity    DefectSeverity @default(MEDIUM)
  status      DefectStatus   @default(OPEN)

  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  environment      String?

  /// Where this came from. Both optional: plenty of bugs are found without a test
  /// case, and the defect has to survive the test case being deleted either way.
  testCaseId String?
  testRunId  String?

  assignedToId String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testRun    TestRun?  @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("DefectAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User      @relation("DefectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([testCaseId])
  @@index([testRunId])
  @@index([assignedToId])
  @@index([createdById])
}
