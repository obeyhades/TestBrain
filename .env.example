# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Matches docker-compose.dev.yml.
DATABASE_URL="postgresql://testbrain:testbrain@localhost:5432/testbrain?schema=public"

# Used to sign session cookies. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-random-32-character-string"

# Public URL the browser uses to reach the app.
APP_URL="http://localhost:3000"

# Port the API listens on.
PORT=4000

NODE_ENV=development
